# 004-CMakeLists-drop-top-level-deps-subdir.patch
#
# Drops the top-level `add_subdirectory(${CMAKE_CURRENT_LIST_DIR}/deps)` call
# introduced in azure-iot-sdk-c LTS_03_2025. The package Makefile rm's
# $(PKG_BUILD_DIR)/deps in Build/Prepare (the bundled parson / macro-utils-c /
# umock-c / uhttp / azure-ctest / testrunnerswitcher submodules; we use the
# installed deps via find_package), so cmake errors with "add_subdirectory
# given source ... which is not an existing directory" without this fix.
# Mirrors the intent of the now-removed
# 001-CMakeList-change-lib-parsion-include.patch.
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -253,7 +253,6 @@
     set(SHARED_UTIL_REAL_TEST_FOLDER ${CMAKE_CURRENT_LIST_DIR}/c-utility/tests/real_test_files CACHE INTERNAL "this is what needs to be included when doing test sources" FORCE)
 endif()

-add_subdirectory(${CMAKE_CURRENT_LIST_DIR}/deps)
 if(${use_installed_dependencies})
     find_package(parson REQUIRED CONFIG)
 endif()
