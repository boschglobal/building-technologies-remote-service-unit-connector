Add a multi-roundtrip GSSAPI/SPNEGO client to azure-c-shared-utility's
http_proxy_io for the rsu feed.

The HTTP-CONNECT proxy IO used by the MQTT-over-WSS transport hand-rolls
the CONNECT line and only supports Basic auth. This patch creates a new
SDK patch (003-mqtt-wss-negotiate-proxy-auth.patch) that, when a proxy
responds 407 with `Proxy-Authenticate: Negotiate`, runs a GSSAPI
handshake (gss_import_name + gss_init_sec_context loop), base64-encodes
the output token and re-issues CONNECT with `Proxy-Authorization:
Negotiate <token>`. Backwards-compatible: only compiled in when the new
use_gssapi CMake option is ON.

The 407 response typically carries an HTML body. Because the patch reuses
the same TCP connection for the follow-up CONNECT, body bytes still in
flight after the headers were parsed would end up consumed as the start
of the next response and trip "Cannot decode HTTP response". The patch
parses Content-Length from the 407 headers and drains any remaining
body bytes from subsequent bytes-received callbacks before resuming
normal status-line parsing. Chunked transfer-encoding and responses
without Content-Length are treated as unsafe to retry.

The rsu Makefile gains:
- `+krb5-libs` in DEPENDS so the linker can find -lgssapi_krb5 at build
  time and the runtime package list includes it on target.
- `-Duse_gssapi:bool=ON` in CMAKE_OPTIONS so the new code path is
  compiled in.

The Negotiate path complements the DPS/HTTPS path enabled by patch 002
(httpapi_curl.c); together they cover both code paths the Azure IoT C
SDK uses for proxy CONNECT.

diff --git a/libs/azure-c-shared-utility/Makefile b/libs/azure-c-shared-utility/Makefile
--- a/libs/azure-c-shared-utility/Makefile
+++ b/libs/azure-c-shared-utility/Makefile
@@ -38,7 +38,8 @@ define Package/azure-c-shared-utility
   DEPENDS:= \
     +libuuid \
     +libopenssl \
-    +libcurl
+    +libcurl \
+    +krb5-libs
 endef
 
 define Package/azure-c-shared-utility/description
@@ -56,6 +57,7 @@ CMAKE_BINARY_SUBDIR:=build_openwrt
 CMAKE_OPTIONS += \
 		-Duse_installed_dependencies:bool=ON \
 		-Drun_unittests:bool=OFF \
+		-Duse_gssapi:bool=ON \
 		-Dbuild_as_dynamic:bool=ON \
 
 define Build/InstallDev
diff --git a/libs/azure-c-shared-utility/patches/003-mqtt-wss-negotiate-proxy-auth.patch b/libs/azure-c-shared-utility/patches/003-mqtt-wss-negotiate-proxy-auth.patch
new file mode 100644
index 0000000..2222222
--- /dev/null
+++ b/libs/azure-c-shared-utility/patches/003-mqtt-wss-negotiate-proxy-auth.patch
@@ -0,0 +1,578 @@
+Add Kerberos/SPNEGO proxy authentication to http_proxy_io for the rsu build.
+
+The HTTP CONNECT proxy IO (used by MQTT-over-WSS) writes the CONNECT line
+by hand and only supports Basic auth. When the proxy responds 407 with a
+'Proxy-Authenticate: Negotiate' challenge, run a GSSAPI handshake against
+the HTTP@<proxy-host> service, base64 the output token, and re-issue
+CONNECT with 'Proxy-Authorization: Negotiate <token>'. Supports the
+multi-roundtrip case (GSS_S_CONTINUE_NEEDED) by leaving the connection
+in WAITING_FOR_CONNECT_RESPONSE between rounds.
+
+Reusing the same connection across the 407/200 round-trip requires
+draining the 407's response body (usually 1-3 KB of HTML) before the
+follow-up response can be parsed, otherwise leftover body bytes corrupt
+the next status line. The patch parses Content-Length from the 407
+headers and skips that many body bytes from subsequent bytes-received
+callbacks before resuming normal parsing. Chunked encoding or responses
+without Content-Length are treated as unsafe to retry.
+
+Compiled in only when use_gssapi=ON; falls back to the existing Basic
+path otherwise so non-OpenWrt builds keep working untouched.
+
+--- a/CMakeLists.txt
++++ b/CMakeLists.txt
+@@ -31,6 +31,7 @@
+ option(use_cppunittest "set use_cppunittest to ON to build CppUnitTest tests on Windows (default is OFF)" OFF)
+ option(suppress_header_searches "do not try to find headers - used when compiler check will fail" OFF)
+ option(use_custom_heap "use externally defined heap functions instead of the malloc family" OFF)
++option(use_gssapi "set use_gssapi to ON to enable Kerberos/SPNEGO proxy authentication in http_proxy_io (default is OFF)" OFF)
+ option(no_openssl_engine "Disables the use of ENGINEs in OpenSSL" OFF)
+ option(enable_ipv6 "set enable_ipv6 to ON to enable dual-ip-stack (IPv4 and IPv6) support (default is OFF for IPv4 only)" OFF)
+
+@@ -607,6 +608,11 @@
+     endif()
+ endif()
+ 
++if(${use_gssapi})
++    set(aziotsharedutil_target_libs ${aziotsharedutil_target_libs} gssapi_krb5)
++    add_definitions(-DAZURE_C_SHARED_UTILITY_USE_GSSAPI=1)
++endif()
++
+ target_link_libraries(aziotsharedutil ${aziotsharedutil_target_libs})
+ if(${build_as_dynamic})
+     target_link_libraries(aziotsharedutil_dll ${aziotsharedutil_target_libs})
